{
  "name": "meetmydash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "meetmydash: app de tableros propia (repositorio tablero).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch servidor/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/version.mjs",
